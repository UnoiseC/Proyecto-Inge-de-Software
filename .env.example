# SERVER
PORT=3000
NODE_ENV=development
CORS_ORIGIN=""

# SUPABASE (Recomendado para conectar el backend a tu proyecto Supabase)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# POSTGRESQL DIRECTO (Opcional: Connection String / Pooler de Supabase)
DATABASE_URL=""

# SEGURIDAD API (Opcional: si REQUIRE_AUTH=true exige JWT de Supabase o X-API-Key)
REQUIRE_AUTH=false
API_ADMIN_KEY=""
QR_SIGNING_SECRET=""

# CORREO ELECTRÓNICO (Resend o SMTP para respaldos de asistencia y reportes PDF)
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="asistencia@jsspcontrol.cl"
